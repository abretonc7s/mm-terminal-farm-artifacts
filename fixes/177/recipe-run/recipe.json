{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "TAT-4035 follow-up account panel and fee smoke",
  "description": "Read-only account panel and fee regression smoke, plus inherited header connect/disconnect actions. Position lifecycle remains covered by the inherited evidence and component tests.",
  "proofTargets": [
    {
      "id": "AC1",
      "claim": "Equity, uPnL, maintenance margin, and margin usage/ratio are all visible and update live off the WS-driven data already flowing through live-positions-query.ts/live-user-info-query.ts."
    },
    {
      "id": "AC2",
      "claim": "Fee tier and post-discount fee display correctly in the order form."
    },
    {
      "id": "AC3",
      "claim": "Top nav supports connect/switch/disconnect and links to settings."
    }
  ],
  "workflow": {
    "entry": "setup-connect",
    "nodes": {
      "setup-connect": {
        "action": "call",
        "ref": "terminal.perps.ensure-connected",
        "params": {
          "signer": "injected",
          "account": "{{params.account}}",
          "market": "{{params.market}}"
        },
        "intent": "Start a fresh slot browser on the reserved market and connect the reserved account through the header",
        "next": "gate-order-form"
      },
      "gate-order-form": {
        "action": "ui.wait_for",
        "test_id": "order-form-tab-market",
        "timeout_ms": 120000,
        "intent": "Make sure the connected trader sees the order form before checking the header",
        "next": "ac3-settings-link"
      },
      "ac3-settings-link": {
        "action": "ui.wait_for",
        "selector": "nav[aria-label=\"Main navigation\"] a[aria-label=\"Settings\"][href=\"/settings\"]",
        "expected": "visible",
        "timeout_ms": 15000,
        "proves": [
          "AC3"
        ],
        "intent": "Confirm the top nav links to Settings",
        "next": "ac3-open-account-menu"
      },
      "ac3-open-account-menu": {
        "action": "ui.press",
        "test_id": "header-account-button",
        "proves": [
          "AC3"
        ],
        "intent": "Open the account menu from the top nav as the trader",
        "next": "ac3-menu-active-account"
      },
      "ac3-menu-active-account": {
        "action": "ui.wait_for",
        "selector": "[role=\"menu\"][aria-label=\"Connected accounts\"] [role=\"menuitem\"]",
        "text": "· Active",
        "text_match": "contains",
        "expected": "visible",
        "timeout_ms": 15000,
        "proves": [
          "AC3"
        ],
        "intent": "Confirm the menu lists the connected account marked active (the account switcher)",
        "next": "ac3-menu-add-account"
      },
      "ac3-menu-add-account": {
        "action": "ui.wait_for",
        "selector": "[role=\"menu\"][aria-label=\"Connected accounts\"] [role=\"menuitem\"][data-key=\"add\"]",
        "text": "Add an account",
        "text_match": "exact",
        "expected": "visible",
        "timeout_ms": 15000,
        "proves": [
          "AC3"
        ],
        "intent": "Confirm the menu offers adding (switching to) another account",
        "next": "ac3-screenshot"
      },
      "ac3-screenshot": {
        "action": "ui.screenshot",
        "path": "screenshots/evidence-ac3-top-nav-account-menu.png",
        "label": "evidence-ac3-top-nav-account-menu",
        "category": "proof",
        "intent": "Keep a picture of the top nav account menu with switch and disconnect options",
        "next": "ac3-menu-disconnect"
      },
      "ac3-menu-disconnect": {
        "action": "ui.press",
        "selector": "[role=\"menu\"][aria-label=\"Connected accounts\"] [role=\"menuitem\"][data-key=\"disconnect\"]",
        "proves": [
          "AC3"
        ],
        "intent": "Disconnect the wallet from the top nav menu",
        "next": "ac3-disconnected"
      },
      "ac3-disconnected": {
        "action": "ui.wait_for",
        "test_id": "header-connect-wallet",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC3"
        ],
        "intent": "Confirm the top nav is back to the Connect wallet button",
        "next": "ac3-connect"
      },
      "ac3-connect": {
        "action": "ui.press",
        "test_id": "header-connect-wallet",
        "proves": [
          "AC3"
        ],
        "intent": "Connect the wallet again from the top nav",
        "next": "ac3-approve-connect"
      },
      "ac3-approve-connect": {
        "action": "call",
        "ref": "terminal.perps.confirm-wallet-request",
        "params": {
          "signer": "injected",
          "kind": "connect"
        },
        "proves": [
          "AC3"
        ],
        "intent": "Let the wallet approve the reconnection",
        "next": "ac3-reconnected"
      },
      "ac3-reconnected": {
        "action": "ui.wait_for",
        "test_id": "header-account-button",
        "expected": "visible",
        "timeout_ms": 60000,
        "proves": [
          "AC3"
        ],
        "intent": "Confirm the top nav shows the connected account again",
        "next": "ac1-panel-visible"
      },
      "ac1-panel-visible": {
        "action": "ui.wait_for",
        "selector": "section[aria-label=\"Account summary\"]",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm the order form shows the account summary panel for the connected trader",
        "next": "ac1-equity"
      },
      "ac1-equity": {
        "action": "ui.wait_for",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm equity shows a live USD value",
        "next": "ac1-upnl",
        "selector": "[data-testid=\"account-summary-equity\"][data-value]"
      },
      "ac1-upnl": {
        "action": "ui.wait_for",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm unrealized PnL shows a live USD value",
        "next": "ac1-maintenance",
        "selector": "[data-testid=\"account-summary-unrealized-pnl\"][data-value]"
      },
      "ac1-maintenance": {
        "action": "ui.wait_for",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm maintenance margin shows a USD value",
        "next": "ac1-margin-usage",
        "selector": "[data-testid=\"account-summary-maintenance-margin\"][data-value]"
      },
      "ac1-margin-usage": {
        "action": "ui.wait_for",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm margin usage shows a percentage",
        "next": "ac1-margin-ratio",
        "selector": "[data-testid=\"account-summary-margin-usage\"][data-value]"
      },
      "ac1-margin-ratio": {
        "action": "ui.wait_for",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC1"
        ],
        "intent": "Confirm cross margin ratio shows a percentage",
        "next": "ac1-wait-claimed",
        "selector": "[data-testid=\"account-summary-margin-ratio\"][data-value]"
      },
      "ac1-wait-claimed": {
        "action": "ui.wait_for",
        "selector": "section[aria-label=\"Account summary\"]",
        "expected": "visible",
        "timeout_ms": 10000,
        "proves": [
          "AC1"
        ],
        "intent": "Hold on the account summary panel before capturing it",
        "next": "ac1-screenshot"
      },
      "ac1-screenshot": {
        "action": "ui.screenshot",
        "path": "screenshots/evidence-ac1-account-summary.png",
        "label": "evidence-ac1-account-summary",
        "category": "proof",
        "intent": "Keep a picture of the account summary panel with equity, uPnL, maintenance margin, margin usage and ratio",
        "next": "ac2-fee-tier"
      },
      "ac2-fee-tier": {
        "action": "ui.wait_for",
        "test_id": "order-summary-fee-tier",
        "text": "Tier ",
        "text_match": "contains",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC2"
        ],
        "intent": "Confirm the order form summary shows the trader's fee tier",
        "next": "ac2-fee-rate"
      },
      "ac2-fee-rate": {
        "action": "ui.wait_for",
        "test_id": "order-summary-fee-rate",
        "text": "%",
        "text_match": "contains",
        "expected": "visible",
        "timeout_ms": 30000,
        "proves": [
          "AC2"
        ],
        "intent": "Confirm the order form summary shows the post-discount fee rate",
        "next": "ac2-wait-claimed"
      },
      "ac2-wait-claimed": {
        "action": "ui.wait_for",
        "test_id": "order-summary-fee-tier",
        "expected": "visible",
        "timeout_ms": 10000,
        "proves": [
          "AC2"
        ],
        "intent": "Hold on the fee tier line before capturing it",
        "next": "ac2-screenshot"
      },
      "ac2-screenshot": {
        "action": "ui.screenshot",
        "path": "screenshots/evidence-ac2-fee-tier.png",
        "label": "evidence-ac2-fee-tier",
        "category": "proof",
        "intent": "Keep a picture of the order summary with the fee tier and post-discount fee",
        "next": "teardown-console"
      },
      "teardown-console": {
        "action": "call",
        "ref": "terminal.perps.assert-clean-console",
        "intent": "Prove the session raised no unexplained console error",
        "next": "done"
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  },
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "account": {
        "type": "string",
        "default": "Trading",
        "description": "Wallet fixture account reserved for slot mmt-3."
      },
      "market": {
        "type": "string",
        "default": "SOL",
        "description": "Testnet market reserved for slot mmt-3."
      },
      "notional": {
        "type": [
          "string",
          "number"
        ],
        "default": "25",
        "description": "Order amount in USD for the testnet position; at least the venue minimum."
      }
    }
  }
}
