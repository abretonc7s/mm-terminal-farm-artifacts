{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Pro order types and order-book click-to-fill",
  "description": "Testnet proof for TAT-4034. Existing Limit guard precedes new controls. Native TWAP is observed through its resulting position after the scheduling window.",
  "proofTargets": [
    {
      "id": "AC1",
      "claim": "All six order types (Stop, Take, Scale, Chase, TWAP, reduce-only — plus existing Market/Limit) are selectable and place real orders against Hyperliquid."
    },
    {
      "id": "AC2",
      "claim": "Slippage estimate displays before submit; max-slippage is enforced."
    },
    {
      "id": "AC3",
      "claim": "Clicking any order-book price row fills the limit-price field."
    }
  ],
  "workflow": {
    "entry": "setup-session",
    "nodes": {
      "setup-session": {
        "action": "call",
        "intent": "Open the slot and connect its reserved testnet wallet",
        "ref": "terminal.perps.ensure-connected",
        "params": {
          "signer": "injected",
          "account": "dev1",
          "market": "ETH"
        },
        "next": "setup-flat"
      },
      "setup-flat": {
        "action": "call",
        "intent": "Converge the reserved testnet market to a flat starting state",
        "ref": "terminal.perps.ensure-flat-market",
        "params": {
          "account": "dev1",
          "market": "ETH",
          "exclusive_testnet_market": true
        },
        "next": "ac1-regression-limit"
      },
      "ac1-regression-limit": {
        "action": "ui.press",
        "intent": "Select the existing Limit order",
        "test_id": "order-form-tab-limit",
        "proves": [
          "AC1"
        ],
        "next": "ac1-regression-limit-field"
      },
      "ac1-regression-limit-field": {
        "action": "ui.wait_for",
        "intent": "Confirm the existing limit-price input renders",
        "test_id": "order-form-limit-price",
        "timeout_ms": 10000,
        "proves": [
          "AC1"
        ],
        "next": "setup-market"
      },
      "setup-market": {
        "action": "ui.press",
        "intent": "Return to Market before the new order controls",
        "test_id": "order-form-tab-market",
        "next": "ac1-stop-select"
      },
      "ac1-stop-select": {
        "action": "ui.press",
        "intent": "Select the new Stop order",
        "test_id": "order-form-tab-stop_market",
        "proves": [
          "AC1"
        ],
        "next": "ac1-stop-field"
      },
      "ac1-stop-field": {
        "action": "ui.wait_for",
        "intent": "Confirm Stop exposes its trigger price",
        "test_id": "order-form-trigger-price",
        "timeout_ms": 10000,
        "proves": [
          "AC1"
        ],
        "next": "ac1-stop-fields"
      },
      "ac1-stop-fields": {
        "action": "ui.screenshot",
        "intent": "Keep visual proof of the prices and risk controls available to this trader",
        "path": "evidence-ac1-stop-fields.png",
        "category": "proof",
        "proves": [
          "AC1"
        ],
        "next": "setup-stop-trigger"
      },
      "setup-stop-trigger": {
        "action": "ui.set_input",
        "intent": "Configure a valid testnet placement that stays outside the market until its venue read",
        "test_id": "order-form-trigger-price",
        "value": "5000.5",
        "next": "setup-stop-size"
      },
      "setup-stop-size": {
        "action": "ui.set_input",
        "intent": "Configure a valid testnet placement that stays outside the market until its venue read",
        "test_id": "order-form-amount",
        "value": "$25",
        "next": "ac1-stop-submit"
      },
      "ac1-stop-submit": {
        "action": "ui.press",
        "intent": "Place the Stop order",
        "test_id": "order-form-submit",
        "proves": [
          "AC1"
        ],
        "next": "setup-approve"
      },
      "setup-approve": {
        "action": "call",
        "intent": "Approve the trading agent for this testnet session",
        "ref": "terminal.perps.confirm-wallet-request",
        "params": {
          "signer": "injected",
          "kind": "signature",
          "primary_type": "HyperliquidTransaction:ApproveAgent"
        },
        "next": "ac1-stop-venue"
      },
      "ac1-stop-venue": {
        "action": "metamask.perps.assert_orders",
        "intent": "Read the resulting Hyperliquid orders",
        "account": "dev1",
        "market": "ETH",
        "network": "testnet",
        "state": "open",
        "expect_count": 1,
        "timeout_ms": 45000,
        "next": "ac1-stop-venue-assert",
        "proves": [
          "AC1"
        ],
        "order_kind": "trigger",
        "expect_trigger_price": 5000.5,
        "expect_reduce_only": false,
        "expect_trigger_order_type": "stop_market"
      },
      "ac1-stop-venue-assert": {
        "action": "assert_output",
        "intent": "Assert the venue read matches the order just submitted",
        "source": "ac1-stop-venue",
        "proves": [
          "AC1"
        ],
        "assert": {
          "path": "$.matchingCount",
          "operator": "eq",
          "value": 1
        },
        "next": "teardown-stop"
      },
